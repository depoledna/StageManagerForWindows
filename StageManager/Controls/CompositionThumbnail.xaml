<UserControl
    x:Class="StageManager.Controls.CompositionThumbnail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:StageManager.Controls"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <Grid>
        <Border Background="#01000000">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="20" />
            </Border.Effect>
        </Border>
        <!-- HostContainer is a sibling of Border (not a child) so it can grow
             past the WPF layout slot via SizeChanged code-behind, giving the
             composition HWND headroom for hover-scale without chopping the
             rounded clip at the HWND boundary. -->
        <Grid x:Name="HostContainer"
              Background="#01000000"
              HorizontalAlignment="Center"
              VerticalAlignment="Center" />
    </Grid>
</UserControl>
